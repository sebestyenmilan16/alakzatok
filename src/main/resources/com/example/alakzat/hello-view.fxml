<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="317.0" prefWidth="475.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.alakzat.HelloController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
   <children>
      <HBox prefHeight="374.0" prefWidth="471.0">
         <children>
            <VBox prefHeight="350.0" prefWidth="243.0">
               <children>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0">
                           <HBox.margin>
                              <Insets right="10.0" />
                           </HBox.margin>
                           <children>
                              <RadioButton fx:id="rb_red" mnemonicParsing="false" text="Piros">
                                 <VBox.margin>
                                    <Insets bottom="10.0" />
                                 </VBox.margin>
                                 <toggleGroup>
                                    <ToggleGroup fx:id="szinek" />
                                 </toggleGroup>
                              </RadioButton>
                              <RadioButton fx:id="rb_zold" mnemonicParsing="false" text="Zöld" toggleGroup="$szinek">
                                 <VBox.margin>
                                    <Insets bottom="10.0" />
                                 </VBox.margin>
                              </RadioButton>
                              <RadioButton fx:id="rb_kek" mnemonicParsing="false" text="Kék" toggleGroup="$szinek" />
                           </children>
                           <padding>
                              <Insets left="20.0" />
                           </padding>
                        </VBox>
                        <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0">
                           <HBox.margin>
                              <Insets left="10.0" />
                           </HBox.margin>
                           <children>
                              <RadioButton fx:id="rb_negyzet" mnemonicParsing="false" text="Négyzet">
                                 <VBox.margin>
                                    <Insets bottom="10.0" />
                                 </VBox.margin>
                                 <toggleGroup>
                                    <ToggleGroup fx:id="alakzatok" />
                                 </toggleGroup>
                              </RadioButton>
                              <RadioButton fx:id="rb_kor" mnemonicParsing="false" text="Kör" toggleGroup="$alakzatok">
                                 <VBox.margin>
                                    <Insets bottom="10.0" />
                                 </VBox.margin>
                              </RadioButton>
                              <RadioButton fx:id="rb_haromszog" mnemonicParsing="false" text="Háromszög" toggleGroup="$alakzatok" />
                           </children>
                           <padding>
                              <Insets left="10.0" />
                           </padding>
                        </VBox>
                     </children></HBox>
                  <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
                     <children>
                        <ImageView fx:id="iw_terulet" fitHeight="150.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true" style="border:: black;" />
                     </children>
                  </VBox>

               </children></VBox>
            <VBox alignment="CENTER" prefHeight="340.0" prefWidth="229.0">
               <children>
                  <HBox alignment="CENTER" prefHeight="39.0" prefWidth="268.0">
                     <children>
                        <Button fx:id="b_hozzaad" mnemonicParsing="false" prefHeight="25.0" prefWidth="100.0" text="Hozzáad">
                           <graphic>
                              <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../../../add16.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </Button>
                        <Button fx:id="b_torol" mnemonicParsing="false" prefHeight="25.0" prefWidth="100.0" text="Töröl">
                           <HBox.margin>
                              <Insets left="20.0" />
                           </HBox.margin>
                           <graphic>
                              <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../../../del16.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </Button>
                     </children>
                     <cursor>
                        <Cursor fx:constant="OPEN_HAND" />
                     </cursor>
                  </HBox>
                  <ListView fx:id="lw_lista" prefHeight="225.0" prefWidth="221.0">
                     <VBox.margin>
                        <Insets bottom="5.0" />
                     </VBox.margin>
                  </ListView>
                  <Button fx:id="b_mentes" mnemonicParsing="false" text="Mentés">
                     <graphic>
                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../../save16.png" />
                           </image></ImageView>
                     </graphic>
                  </Button>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
